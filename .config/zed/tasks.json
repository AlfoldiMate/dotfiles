// Global Zed tasks. Tasks selected via <space>tt (task::Spawn) /
// <space>tr (task::Rerun). Per-project tasks belong in `.zed/tasks.json`.
//
// Available variables (referenced as $ZED_VAR or ${ZED_VAR:default}):
//   $ZED_FILE              absolute path of current file
//   $ZED_FILENAME          basename
//   $ZED_RELATIVE_FILE     path relative to worktree root
//   $ZED_DIRNAME           directory of current file
//   $ZED_STEM              filename w/o extension
//   $ZED_WORKTREE_ROOT     project root
//   $ZED_SYMBOL            symbol under cursor (function / class)
//   $ZED_SELECTED_TEXT     current selection
//   $ZED_LANGUAGE          language id
//   $ZED_ROW, $ZED_COLUMN  1-based cursor pos
//
// Tags drive inline ▶ "Run test" indicators above test fns/classes when
// the language tree-sitter exposes the right captures. They also let
// task::Spawn filter context-relevant tasks first.
[
  // ──────────────────────────────────────────────────────────────────
  // Node / TypeScript / JavaScript
  // ──────────────────────────────────────────────────────────────────
  {
    "label": "npm: test (project)",
    "command": "npm",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["js-test", "ts-test"]
  },
  {
    "label": "npm: test (file)",
    "command": "npm",
    "args": ["test", "--", "$ZED_RELATIVE_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["js-test", "ts-test"]
  },
  {
    "label": "vitest: nearest ($ZED_SYMBOL)",
    "command": "npx",
    "args": ["vitest", "run", "$ZED_RELATIVE_FILE", "-t", "${ZED_SYMBOL:.*}"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["js-test", "ts-test", "vitest-test"]
  },
  {
    "label": "vitest: file",
    "command": "npx",
    "args": ["vitest", "run", "$ZED_RELATIVE_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["js-test", "ts-test", "vitest-test"]
  },
  {
    "label": "vitest: watch",
    "command": "npx",
    "args": ["vitest", "$ZED_RELATIVE_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true
  },
  {
    "label": "jest: nearest ($ZED_SYMBOL)",
    "command": "npx",
    "args": ["jest", "$ZED_RELATIVE_FILE", "-t", "${ZED_SYMBOL:.*}"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["js-test", "ts-test", "jest-test"]
  },
  {
    "label": "node: run current file",
    "command": "node",
    "args": ["$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "tsx: run current file",
    "command": "npx",
    "args": ["tsx", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },

  // ──────────────────────────────────────────────────────────────────
  // Python (pytest)
  // ──────────────────────────────────────────────────────────────────
  {
    "label": "pytest: project",
    "command": "pytest",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["python-test", "pytest-test"]
  },
  {
    "label": "pytest: file",
    "command": "pytest",
    "args": ["$ZED_RELATIVE_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["python-test", "pytest-test"]
  },
  {
    "label": "pytest: nearest ($ZED_SYMBOL)",
    "command": "pytest",
    "args": ["$ZED_RELATIVE_FILE::${ZED_SYMBOL:}", "-v"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["python-test", "pytest-test"]
  },
  {
    "label": "python: run current file",
    "command": "python",
    "args": ["$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },

  // ──────────────────────────────────────────────────────────────────
  // Rust (cargo)
  // ──────────────────────────────────────────────────────────────────
  {
    "label": "cargo: test (project)",
    "command": "cargo",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["rust-test"]
  },
  {
    "label": "cargo: test (nearest)",
    "command": "cargo",
    "args": ["test", "$ZED_SYMBOL", "--", "--nocapture"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["rust-test"]
  },
  {
    "label": "cargo: run",
    "command": "cargo",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "cargo: check",
    "command": "cargo",
    "args": ["check"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },

  // ──────────────────────────────────────────────────────────────────
  // Go
  // ──────────────────────────────────────────────────────────────────
  {
    "label": "go: test (package)",
    "command": "go",
    "args": ["test", "./..."],
    "cwd": "$ZED_DIRNAME",
    "reveal": "always",
    "tags": ["go-test"]
  },
  {
    "label": "go: test (nearest)",
    "command": "go",
    "args": ["test", "-run", "${ZED_SYMBOL:.*}", "-v"],
    "cwd": "$ZED_DIRNAME",
    "reveal": "always",
    "tags": ["go-test"]
  },
  {
    "label": "go: run current file",
    "command": "go",
    "args": ["run", "$ZED_FILE"],
    "cwd": "$ZED_DIRNAME",
    "reveal": "always"
  },

  // ──────────────────────────────────────────────────────────────────
  // Java / Maven / Gradle  (basic project-level only; per-test usually
  // needs a Surefire/Gradle-test invocation per project setup — extend
  // in the project's .zed/tasks.json)
  // ──────────────────────────────────────────────────────────────────
  {
    "label": "maven: test",
    "command": "mvn",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["java-test"]
  },
  {
    "label": "maven: verify",
    "command": "mvn",
    "args": ["verify"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "gradle: test",
    "command": "./gradlew",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["java-test"]
  },

  // ──────────────────────────────────────────────────────────────────
  // Quick utilities
  // ──────────────────────────────────────────────────────────────────
  {
    "label": "shell: run selected text",
    "command": "${ZED_SELECTED_TEXT:echo no selection}",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true
  },
  {
    "label": "git: status",
    "command": "git",
    "args": ["status"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  }
]
