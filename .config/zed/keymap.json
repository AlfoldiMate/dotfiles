// Zed keymap — LazyVim-inspired vim mode on top of VS Code base keymap.
//
// Why the leader-key fix:
//   Without an explicit "space"-as-prefix binding (and a no-op for bare
//   "space"), pressing <space> in normal mode falls through to vim's default
//   "move-cursor-right" after ~1s. The fix is twofold:
//     1. Define every <leader>X sequence we want — that registers "space" as
//        a multi-key prefix and Zed's which_key popover appears.
//     2. Bind bare "space" itself (here: menu::Cancel, a harmless no-op) so
//        it never resolves to "move right" on its own.
//   The "vim_mode == normal | visual" contexts ensure these only fire in
//   those modes — insert mode is untouched.
//
// Bindings here mirror ~/.ideavimrc / LazyVim. VS Code muscle memory
// (cmd-p, cmd-shift-p, cmd-b, cmd-f, cmd-shift-f, cmd-s, cmd-w, cmd-/, f12,
// f2, cmd-., etc.) keeps working via Zed's default macOS keymap.
[
  // ──────────────────────────────────────────────────────────────────
  // NORMAL & VISUAL — Window navigation, line move, buffer switch
  // (no-leader LazyVim idioms)
  // ──────────────────────────────────────────────────────────────────
  {
    "context": "VimControl && !menu",
    "bindings": {
      // <C-h/j/k/l> — move between panes
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",

      // [b / ]b and <S-h>/<S-l> — prev/next buffer
      "[ b": "pane::ActivatePreviousItem",
      "] b": "pane::ActivateNextItem",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",

      // [d / ]d and [e / ]e — prev/next diagnostic
      "[ d": "editor::GoToPreviousDiagnostic",
      "] d": "editor::GoToDiagnostic",
      "[ e": "editor::GoToPreviousDiagnostic",
      "] e": "editor::GoToDiagnostic",

      // [h / ]h — prev/next git hunk
      "[ h": "editor::GoToPreviousHunk",
      "] h": "editor::GoToHunk"
    }
  },

  // Visual-only: line moves + keep selection on indent + sneak
  {
    "context": "vim_mode == visual",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      ">": ["workspace::SendKeystrokes", "> g v"],
      "<": ["workspace::SendKeystrokes", "< g v"],
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward"
    }
  },

  // Normal-only: line moves + goto-prefix LSP nav
  {
    "context": "vim_mode == normal",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",

      // ── Goto navigation (no-leader g-prefix, LazyVim) ─────────────
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDeclaration",
      "g r": "editor::FindAllReferences",
      "g I": "editor::GoToImplementation",
      "g y": "editor::GoToTypeDefinition",
      "g K": "editor::ShowSignatureHelp",

      // ── Flash / Sneak — `s` jumps to a 2-char sequence (LazyVim) ──
      // Overrides vim's default `s = substitute char` (we have `cl` for that).
      // `s` forward, `S` backward — like vim-sneak / flash.nvim.
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward"
    }
  },

  // ──────────────────────────────────────────────────────────────────
  // LEADER (<space>) — only in normal & visual, NEVER in insert.
  //
  // The bare "space" binding below stops vim's default "move-right"
  // from firing after the pending-key timeout.
  // ──────────────────────────────────────────────────────────────────
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      // Swallow bare space so it never falls through to vim's default
      // "move right" motion. `null` disables the bare binding entirely,
      // leaving "space" usable only as a multi-key prefix.
      "space": null,

      // ── Top-level pickers ─────────────────────────────────────────
      "space space": "file_finder::Toggle",        // <leader><space> files
      "space ,": "tab_switcher::Toggle",           // <leader>,         buffers
      "space /": "pane::DeploySearch",             // <leader>/         grep
      "space :": "command_palette::Toggle",        // <leader>:         command palette
      "space `": "pane::AlternateFile",            // <leader>`         alt buffer
      "space -": "pane::SplitDown",                // <leader>-         split below
      "space |": "pane::SplitRight",               // <leader>|         split right
      "space e": "project_panel::Toggle",

      // ── Buffers ───────────────────────────────────────────────────
      "space b b": "pane::AlternateFile",
      "space b d": ["pane::CloseActiveItem", { "close_pinned": false }],
      "space b o": ["pane::CloseOtherItems", { "close_pinned": false }],
      "space b p": "pane::TogglePinTab",

      // ── Code (LSP) ────────────────────────────────────────────────
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "space c d": "diagnostics::Deploy",

      // ── Debug (DAP via debugger::, breakpoints via editor::) ──────
      // Mirrors LazyVim <leader>d… group. Zed's built-in DAP covers
      // C/C++/Go/JS/TS/Python/Rust; Java/Ruby/Swift via extensions.
      "space d b": "editor::ToggleBreakpoint",
      "space d B": "editor::EditLogBreakpoint",       // conditional/log
      "space d c": "debugger::Continue",              // continue (F5)
      "space d C": "debugger::Continue",              // continue (no run-to-cursor in Zed)
      "space d i": "debugger::StepInto",
      "space d o": "debugger::StepOut",
      "space d O": "debugger::StepOver",
      "space d l": "debugger::Start",                 // launch/run debug
      "space d P": "debugger::Pause",
      "space d r": "task::Spawn",                     // task picker
      "space d R": "debugger::RerunSession",          // restart session
      "space d t": "debugger::Stop",                  // terminate
      "space d u": "debug_panel::ToggleFocus",        // dap UI

      // ── Test (uses tasks; see ~/.config/zed/tasks.json for global,
      //    or .zed/tasks.json per project, for "run nearest" etc.) ──
      "space t t": "task::Spawn",                     // pick a task / test
      "space t r": ["task::Rerun", { "reevaluate_context": true }],   // rerun, fresh context (e.g. cursor moved)
      "space t l": ["task::Rerun", { "reevaluate_context": false }],  // run last (same args)
      "space t o": "terminal_panel::ToggleFocus",     // output panel
      "space t O": "terminal_panel::ToggleFocus",
      "space t S": "debugger::Stop",                  // stop running test/debug

      // ── Diagnostics / quickfix ────────────────────────────────────
      "space x x": "diagnostics::Deploy",
      "space x l": "diagnostics::Deploy",
      "space x q": "diagnostics::Deploy",

      // ── Explorer / files ──────────────────────────────────────────
      "space e": "workspace::ToggleLeftDock",
      "space E": "workspace::ToggleLeftDock",
      "space f e": "workspace::ToggleLeftDock",
      "space f f": "file_finder::Toggle",
      "space f F": "file_finder::Toggle",
      "space f r": "file_finder::Toggle",
      "space f n": "workspace::NewFile",
      "space f s": "workspace::Save",
      "space f t": "terminal_panel::ToggleFocus",

      // ── Git ───────────────────────────────────────────────────────
      "space g g": "git_panel::ToggleFocus",
      "space g b": "git::Blame",
      "space g B": "git::Blame",
      "space g d": "git::Diff",
      "space g e": "git_panel::ToggleFocus",
      "space g s": "git_panel::ToggleFocus",

      // ── Search (Telescope-style) ──────────────────────────────────
      "space s s": "outline::Toggle",              // symbols in file
      "space s S": "project_symbols::Toggle",      // workspace symbols
      "space s g": "pane::DeploySearch",
      "space s G": "pane::DeploySearch",
      "space s d": "diagnostics::Deploy",
      "space s D": "diagnostics::Deploy",
      "space s w": "pane::DeploySearch",
      "space s W": "pane::DeploySearch",
      "space s h": "command_palette::Toggle",
      "space s k": "command_palette::Toggle",
      "space s C": "command_palette::Toggle",
      "space s c": "command_palette::Toggle",
      "space s j": "outline_panel::ToggleFocus",
      "space s m": "outline::Toggle",
      "space s r": "buffer_search::Deploy",
      "space s t": "diagnostics::Deploy",

      // ── UI toggles ────────────────────────────────────────────────
      "space u h": "editor::ToggleInlayHints",
      "space u l": "editor::ToggleLineNumbers",
      "space u w": "editor::ToggleSoftWrap",
      "space u C": "theme_selector::Toggle",

      // ── Windows / panes ───────────────────────────────────────────
      "space w d": "pane::CloseActiveItem",
      "space w s": "pane::SplitDown",
      "space w v": "pane::SplitRight",
      "space w h": "workspace::ActivatePaneLeft",
      "space w j": "workspace::ActivatePaneDown",
      "space w k": "workspace::ActivatePaneUp",
      "space w l": "workspace::ActivatePaneRight",
      "space w m": "workspace::ToggleZoom",

      // ── Quit ──────────────────────────────────────────────────────
      "space q q": "zed::Quit"
    }
  },

  // ──────────────────────────────────────────────────────────────────
  // Terminal toggle (<C-/>) — outside leader, mirrors LazyVim
  // ──────────────────────────────────────────────────────────────────
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-/": "terminal_panel::ToggleFocus"
    }
  },
]
