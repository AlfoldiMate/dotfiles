# Ghostty configuration
# Docs: https://ghostty.org/docs/config

# --- Theme ---
theme = Catppuccin Macchiato

# --- Tabs in the title bar (native macOS tabs) ---
macos-titlebar-style = tabs

# --- Custom app icon (Catppuccin Macchiato, from jasonlong/ghostty-theme-icons) ---
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/catppuccin-macchiato.icns

# --- macOS niceties ---
# Right Option behaves as Alt so terminal keybinds work; left Option still types accents.
macos-option-as-alt = right
# Subtle translucency + blur (set background-opacity to 1 to disable).
background-opacity = 0.96
background-blur-radius = 20
# Restore windows/tabs after quit & relaunch.
window-save-state = always
# Don't nag when closing a tab/window that has no running process.
confirm-close-surface = false
quit-after-last-window-closed = true

# --- Quality of life ---
mouse-hide-while-typing = true
copy-on-select = clipboard
window-padding-x = 8
window-padding-y = 6
cursor-style = block
cursor-style-blink = false

# --- Font (uses system default if these aren't installed) ---
font-family = JetBrainsMono Nerd Font Mono
font-size = 13
